{
    "env": {
        "browser": true,
        "es2021": true,
        "node": true,
        "googleappsscript/googleappsscript": true
    },
    "extends": "eslint:recommended",
    "plugins": [
        "html",
        "googleappsscript"
    ],
    "parserOptions": {
        "ecmaVersion": 12
    },
    "rules": {
        "no-unused-vars": "warn",
        "no-undef": "warn",
        "no-implicit-globals": "warn"
    },
    "settings": {
        "html/html-extensions": [".html"]
    }
}
